# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Language: es
  # SPEC PERIOD ONLY — this site carries 192 real before/after photographs of his
  # patients and the engagement is unsigned (CLAUDE.md §3).
  # DELETE THE NEXT LINE ON LAUNCH DAY, NOT BEFORE.
  X-Robots-Tag: noindex, nofollow

/img/*
  Cache-Control: public, max-age=31536000, immutable
/video/*
  Cache-Control: public, max-age=31536000, immutable
